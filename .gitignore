# Pixi and local tool installations
.pixi/
.tools/
.local/
.cache/

# Track all projects, source assets, and finished renders (including legacy media/).
# Ignore only Manim's reproducible intermediate caches in render directories.
/media/Tex/
/media/texts/
/media/videos/**/partial_movie_files/
/output/Tex/
/output/texts/
/output/videos/**/partial_movie_files/
projects/**/output/Tex/
projects/**/output/texts/
projects/**/output/videos/**/partial_movie_files/

# Python bytecode and TeX diagnostic output
__pycache__/
*.py[cod]
missfont.log

# Python tooling
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/
.venv/

# Local editor and OS files
.DS_Store
*.swp
